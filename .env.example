# Public app URL used for metadata and shared links.
NEXT_PUBLIC_APP_URL=http://127.0.0.1:43123

# Robinhood Chain. Mainnet chain ID is 4663. Testnet is 46630.
NEXT_PUBLIC_CHAIN_ID=4663
NEXT_PUBLIC_RPC_URL=https://rpc.mainnet.chain.robinhood.com
NEXT_PUBLIC_TESTNET_RPC_URL=https://rpc.testnet.chain.robinhood.com
NEXT_PUBLIC_EXPLORER_URL=https://robinhoodchain.blockscout.com
NEXT_PUBLIC_TESTNET_EXPLORER_URL=https://explorer.testnet.chain.robinhood.com

# Optional WalletConnect Cloud project ID. Leave empty to use injected wallets only.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# Contract addresses. Leave empty until the contracts are deployed.
# Do not put a placeholder address here.
NEXT_PUBLIC_VIRE_TOKEN_ADDRESS=
NEXT_PUBLIC_USDC_ADDRESS=
NEXT_PUBLIC_PAYMENT_ROUTER_ADDRESS=
NEXT_PUBLIC_USERNAME_REGISTRY_ADDRESS=
NEXT_PUBLIC_SWAP_ROUTER_ADDRESS=

# Optional public contact address.
NEXT_PUBLIC_CONTACT_EMAIL=

# Server-only. Never prefix private keys or database URLs with NEXT_PUBLIC_.
RPC_URL=
DATABASE_URL=
